<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Interfaz No. 1 - Mantenimientos. Se reutiliza para museos, salas, colecciones,
    especies, temáticas, precios y comisiones; el controlador se asigna desde
    PrincipalController (MuseosController, SalasController, etc.).
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" styleClass="pantalla">
    <HBox alignment="CENTER_LEFT" styleClass="encabezado">
        <VBox>
            <Label text="MANTENIMIENTOS" styleClass="supertitulo"/>
            <Label fx:id="lblTitulo" styleClass="titulo-pantalla"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblFecha" styleClass="etiqueta-fecha"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="tarjeta">
        <Label fx:id="lblFiltroTexto" styleClass="etiqueta-campo"/>
        <TextField fx:id="txtFiltro" onAction="#filtrar" prefWidth="240" HBox.hgrow="SOMETIMES"/>
        <Label fx:id="lblFiltroCombo" styleClass="etiqueta-campo"/>
        <ComboBox fx:id="cmbFiltro" prefWidth="270" HBox.hgrow="SOMETIMES"/>
        <Button text="FILTRAR" onAction="#filtrar" styleClass="boton-primario" minWidth="90"/>
        <Button text="Limpiar" onAction="#limpiarFiltros" styleClass="boton-secundario" minWidth="80"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="lblConteo" styleClass="texto-suave"/>
        <HBox fx:id="panelExtra" spacing="10" alignment="CENTER_LEFT"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnEliminar" text="ELIMINAR" onAction="#eliminar" styleClass="boton-peligro" minWidth="110"/>
        <Button fx:id="btnEditar" text="EDITAR" onAction="#editar" styleClass="boton-secundario" minWidth="110"/>
        <Button fx:id="btnInsertar" text="INSERTAR" onAction="#insertar" styleClass="boton-primario" minWidth="110"/>
    </HBox>
</VBox>
