<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Reporte: salas mejor valoradas por museo; se puede invertir para obtener las diez peores -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cr.ac.una.mahn.controlador.ReporteValoracionesController" styleClass="pantalla">
    <HBox alignment="CENTER_LEFT" styleClass="encabezado">
        <VBox>
            <Label text="REPORTES" styleClass="supertitulo"/>
            <Label text="VALORACIÓN DE LAS SALAS" styleClass="titulo-pantalla"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblFecha" styleClass="etiqueta-fecha"/>
    </HBox>

    <Label wrapText="true" styleClass="texto-suave"
           text="Listado de las salas mejor valoradas por museo. El informe se puede invertir para obtener las diez peores salas valoradas."/>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="tarjeta">
        <Label text="Museo:" styleClass="etiqueta-campo" minWidth="-Infinity"/>
        <ComboBox fx:id="cmbMuseo" prefWidth="250" minWidth="160"/>
        <RadioButton fx:id="rbMejores" text="Mejor valoradas" selected="true" minWidth="-Infinity">
            <toggleGroup>
                <ToggleGroup fx:id="grupoOrden"/>
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="rbPeores" text="Peor valoradas (invertir)" toggleGroup="$grupoOrden" minWidth="-Infinity"/>
        <Label text="Cantidad:" styleClass="etiqueta-campo" minWidth="-Infinity"/>
        <Spinner fx:id="spCantidad" prefWidth="80" minWidth="80"/>
        <Button text="GENERAR" onAction="#generar" styleClass="boton-primario" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnPdf" text="Exportar a PDF" onAction="#exportarPdf" styleClass="boton-dorado" minWidth="-Infinity"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS"/>
    <Label fx:id="lblResumen" styleClass="texto-suave"/>
</VBox>
